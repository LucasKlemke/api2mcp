{
  "name": "api2mcp-cli",
  "version": "0.1.0",
  "description": "Transforma qualquer API com spec OpenAPI em um servidor MCP, com descrições otimizadas para agentes",
  "type": "module",
  "bin": {
    "api2mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "ai",
    "agents",
    "llm"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsup src/cli.ts --format esm --target node20 --clean",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/cli.js",
    "ui": "node dist/cli.js ui",
    "demo": "tsx scripts/demo-client.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^14.0.3",
    "hono": "^4.13.12",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-types": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
